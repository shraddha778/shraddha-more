# Create a Streamlit grocery bill calculator.
"""
Created on Tue May 12 15:44:39 2026

@author: shraddha
"""

import streamlit as st

# Title
st.title("🛒 Grocery Bill Calculator")

# Sidebar for adding items
st.sidebar.header("Add Grocery Items")

# Number of items
num_items = st.sidebar.number_input("How many items?", min_value=1, max_value=20, value=3)

# Store items in a list
items = []
for i in range(num_items):
    st.sidebar.subheader(f"Item {i+1}")
    name = st.sidebar.text_input(f"Name of item {i+1}", key=f"name_{i}")
    price = st.sidebar.number_input(f"Price of item {i+1}", min_value=0.0, format="%.2f", key=f"price_{i}")
    quantity = st.sidebar.number_input(f"Quantity of item {i+1}", min_value=1, value=1, key=f"qty_{i}")
    items.append({"name": name, "price": price, "quantity": quantity})

# Display bill
st.header("🧾 Your Grocery Bill")
total = 0
for item in items:
    if item["name"]:  # Only show if name is entered
        cost = item["price"] * item["quantity"]
        total += cost
        st.write(f"{item['name']} - {item['quantity']} × ₹{item['price']:.2f} = ₹{cost:.2f}")

st.subheader(f"💰 Total Bill: ₹{total:.2f}")
