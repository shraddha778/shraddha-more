import streamlit as st

# Title of the app
st.title("🧍 BMI Health Checker")

# Input fields
st.header("Enter your details:")
weight = st.number_input("Weight (kg)", min_value=1.0, step=0.1)
height = st.number_input("Height (cm)", min_value=1.0, step=0.1)

# BMI calculation
if weight > 0 and height > 0:
    bmi = weight / ((height / 100) ** 2)
    st.subheader(f"Your BMI is: {bmi:.2f}")

    # Health category
    if bmi < 18.5:
        st.warning("⚠️ Underweight: You may need to gain some weight for better health.")
    elif 18.5 <= bmi < 24.9:
        st.success("✅ Normal weight: Great job! Keep maintaining your lifestyle.")
    elif 25 <= bmi < 29.9:
        st.info("ℹ️ Overweight: Consider adopting healthier habits.")
    else:
        st.error("❌ Obese: It's recommended to consult a healthcare professional.")
else:
    st.write("Please enter valid height and weight values.")

# Footer
st.caption("BMI is a general guideline. For personalized advice, consult a healthcare provider.")
