# Python program to count frequency of items purchased by customers

# List of purchased items
purchased_items = [
    "Laptop",
    "Mobile",
    "Laptop",
    "Headphones",
    "Mobile",
    "Laptop",
    "Mouse",
    "Headphones",
    "Mobile"
]

print("Purchased Items:\n")
print(purchased_items)

# Count frequency of each item
frequency = {}

for item in purchased_items:
    if item in frequency:
        frequency[item] += 1
    else:
        frequency[item] = 1

# Display frequency count
print("\nFrequency of Items Purchased:\n")

for item, count in frequency.items():
    print(f"{item} : {count}")
