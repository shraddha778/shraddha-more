# Python program to handle invalid product index in a shopping cart

cart = ["Laptop", "Mouse", "Keyboard", "Headphones"]

print("Shopping Cart:")
for i in range(len(cart)):
    print(i, ":", cart[i])

try:
    index = int(input("Enter product index to remove: "))

    if index < 0 or index >= len(cart):
        print("Invalid product index!")
    else:
        removed_item = cart.pop(index)
        print(removed_item, "removed from cart.")
        print("Updated Cart:", cart)

except ValueError:
    print("Invalid input! Please enter a valid number.")
